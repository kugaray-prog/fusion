<elementProp name="position" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.name">position</stringProp><stringProp name="Argument.value">Instructor I</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
<elementProp name="gender" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.name">gender</stringProp><stringProp name="Argument.value">Female</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
