# ============================================================
# GeoAttend — .gitignore
# ============================================================

# --- Secrets ---
# Never commit real credentials. .env.example (if you create one) documents
# which variables are needed without the real values.
.env
.env.*
!.env.example

# --- Dependencies ---
node_modules/
mobile/node_modules/

# --- Face recognition models (large binaries) ---
# Optional buffalo_l models: too large for GitHub (see models/README.md).
models/det_10g.onnx
models/w600k_r50.onnx

# --- User-uploaded content ---
# Enrolled faces, selfies, OCR scans, imported files -- runtime data, not
# source code. Keeps the folders themselves (via .gitkeep below) so
# multer's upload paths exist on a fresh clone.
uploads/*/*
!uploads/*/.gitkeep
uploads/.sync-state.json

# --- Logs ---
*.log
npm-debug.log*

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Expo / React Native (mobile/) ---
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/*.jks
mobile/*.p8
mobile/*.p12
mobile/*.key
mobile/*.mobileprovision
mobile/*.orig.*
mobile/.metro-health-check*
mobile/ios/
mobile/android/
# ^ Only relevant if you ever run `expo prebuild` locally to get native
# projects -- EAS Build (the workflow this project's mobile/eas.json is set
# up for) generates these in the cloud instead, so they don't need to exist
# in this repo at all in the normal workflow.

# --- Stray folder from an unexpanded Windows %ProgramData% path ---
mobile/%ProgramData%/

# --- JMeter load-test output ---
loadtest/results/
loadtest/cases/data/

# Local-only APK builds served for phone download
public/downloads/
